<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const W=96,H=48,CS=16,NC=W/CS,SEA=17,N=14,D=new Uint8Array(W*H*W),I=(x,y,z)=>(y*W+z)*W+x;
