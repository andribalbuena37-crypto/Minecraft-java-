const key=cx_*NC+cz_;if(ch[key])ch[key].forEach(m=>{scene.remove(m);m.geometry.dispose()});
ch[key]=[mk(o,mO),mk(w,mW)].filter(Boolean)}
for(let a=0;a<NC;a++)for(let b=0;b<NC;b++)buildC(a,b);
function setB(x,y,z,v){D[I(x,y,z)]=v;const a=x>>4,b=z>>4;buildC(a,b);
if(x%16==0&&a>0)buildC(a-1,b);if(x%16==15&&a<NC-1)buildC(a+1,b);if(z%16==0&&b>0)buildC(a,b-1);if(z%16==15&&b<NC-1)buildC(a,b+1)}
// Cielo: sol, luna cuadrados, nubes
const sk=new THREE.Group();scene.add(sk);
const sq=(c,y)=>{const m=new THREE.Mesh(new THREE.PlaneGeometry(40,40),new THREE.MeshBasicMaterial({color:c,fog:false,depthWrite:false,side:THREE.DoubleSide}));m.position.y=y;m.rotation.x=Math.PI/2;m.renderOrder=-1;sk.add(m)};
sq(0xfff4b0,150);sq(0xd8dcec,-150);
const cc=document.createElement('canvas');cc.width=cc.height=32;const c2=cc.getContext('2d');c2.fillStyle='#fff';
for(let x=0;x<32;x++)for(let y=0;y<32;y++)if(vn(x/4,y/4,8)>.6)c2.fillRect(x,y,1,1);
const CT=new THREE.CanvasTexture(cc);CT.wrapS=CT.wrapT=THREE.RepeatWrapping;CT.repeat.set(3,3);CT.magFilter=CT.minFilter=THREE.NearestFilter;
const cm=new THREE.MeshBasicMaterial({map:CT,transparent:true,opacity:.85,side:THREE.DoubleSide,fog:false,depthWrite:false});
const cl=new THREE.Mesh(new THREE.PlaneGeometry(600,600),cm);cl.rotation.x=-Math.PI/2;cl.position.y=H+14;scene.add(cl);
const sel=new THREE.LineSegments(new THREE.EdgesGeometry(new THREE.BoxGeometry(1.004,1.004,1.004)),new THREE.LineBasicMaterial({color:0}));scene.add(sel);
const crk=new THREE.Mesh(new THREE.BoxGeometry(1.006,1.006,1.006),new THREE.MeshBasicMaterial({color:0,transparent:true,opacity:0,depthWrite:false}));scene.add(crk);
// ===== Inventario / HUD =====
let inv=[],cur=0,cre=false;const hud=document.getElementById('hud'),sl=[];
for(let i=0;i<9;i++){const d=document.createElement('div');d.className='s';const c=document.createElement('canvas');c.width=c.height=16;const t=document.createElement('b');d.append(c,t);d.onclick=()=>pick(i);hud.appendChild(d);sl.push({d,c:c.getContext('2d'),t});inv.push({b:0,n:0})}
function draw(){sl.forEach((e,i)=>{const s=inv[i];e.c.clearRect(0,0,16,16);if(s.n)e.c.drawImage(cv,TT[s.b][1]*16,0,16,16,0,0,16,16);e.t.textContent=s.n>1&&!cre?s.n:'';e.d.classList.toggle('on',i==cur)})}
function pick(i){cur=(i+9)%9;draw()}
function setCre(v){cre=v;inv=Array.from({length:9},(_,i)=>v?{b:[1,2,3,4,5,6,7,10,8][i],n:64}:{b:0,n:0});draw()}
function add(b){if(!b)return;const s=inv.find(s=>s.b==b&&s.n<64)||inv.find(s=>!s.n);if(s){s.b=b;s.n++;draw()}}
setCre(false);
// ===== Jugador =====
const P=new THREE.Vector3(),V=new THREE.Vector3();let yaw=0,pitch=0,ground=false,jmp=false,down=false,locked=false,cfo=false,bk='',bp=0,ang=.5;
let sx=W/2;for(let r=0;r<40;r++)if(hm[(W/2+r)*W+W/2]>SEA+1){sx=W/2+r;break}
