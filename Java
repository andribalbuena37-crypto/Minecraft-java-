while(hit(P.x,P.y,P.z))P.y++;
const K={},m=document.getElementById('m'),cf=document.getElementById('cf'),touch='ontouchstart' in window;
addEventListener('keydown',e=>{K[e.code]=1;if(e.code=='Space')e.preventDefault();if(e.key>='1'&&e.key<='9')pick(e.key-1);
if(e.code=='KeyG')setCre(!cre);if(e.code=='KeyE')toggleCf()});
addEventListener('keyup',e=>K[e.code]=0);
