const HD={1:.6,2:.5,3:1.5,4:2,5:2,6:.2,7:.5,8:3,9:3,10:2},DR={1:2,3:4,6:0};
// ===== Mundo =====
const hm=[];let sd=1;const rnd=()=>hs(sd++,7,1);
for(let x=0;x<W;x++)for(let z=0;z<W;z++){
const h=Math.floor(20+(vn(x/28,z/28,1)-.5)*26+(vn(x/9,z/9,2)-.5)*7+(vn(x/3,z/3,3)-.5)*1.5);hm[x*W+z]=h;
for(let y=0;y<=Math.max(h,SEA);y++){let b=0;
