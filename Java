document.getElementById('r1').onclick=()=>{const s=inv.find(s=>s.b==5&&s.n>0);if(s&&!cre){s.n--;if(!s.n)s.b=0;for(let i=0;i<4;i++)add(10);draw()}};
document.getElementById('cx').onclick=toggleCf;be.onclick=toggleCf;
document.getElementById('go').onclick=()=>{setCre(ck.checked);m.style.display='none';if(touch){document.querySelectorAll('.t').forEach(b=>b.style.display='block')}else R.domElement.requestPointerLock()};
document.addEventListener('pointerlockchange',()=>{locked=document.pointerLockElement==R.domElement;if(!locked&&!touch&&!cfo)m.style.display='flex'});
addEventListener('mousemove',e=>{if(!locked)return;yaw-=e.movementX*.0022;pitch=Math.max(-1.55,Math.min(1.55,pitch-e.movementY*.0022))});
addEventListener('wheel',e=>pick(cur+(e.deltaY>0?1:-1)));addEventListener('contextmenu',e=>e.preventDefault());
addEventListener('mousedown',e=>{if(!locked)return;if(e.button==0)down=true;else if(e.button==2)put()});addEventListener('mouseup',e=>{if(e.button==0)down=false});
function ray(){const d=new THREE.Vector3();cam.getWorldDirection(d);let prev=null;
for(let t=0;t<5;t+=.04){const x=Math.floor(P.x+d.x*t),y=Math.floor(P.y+d.y*t),z=Math.floor(P.z+d.z*t),b=gb(x,y,z);
