else b=12;D[I(x,y,z)]=b}}
for(let i=0;i<70;i++){const x=3+Math.floor(rnd()*(W-6)),z=3+Math.floor(rnd()*(W-6)),h=hm[x*W+z];
if(h<=SEA+1||D[I(x,h,z)]!=1)continue;const t=4+Math.floor(rnd()*3);
for(let dy=t-2;dy<=t+1;dy++){const r=dy>=t?1:2;for(let dx=-r;dx<=r;dx++)for(let dz=-r;dz<=r;dz++){
if(r==2&&Math.abs(dx)==2&&Math.abs(dz)==2&&rnd()<.5)continue;if(dy==t+1&&Math.abs(dx)+Math.abs(dz)>1)continue;
if(!D[I(x+dx,h+dy,z+dz)])D[I(x+dx,h+dy,z+dz)]=6}}
for(let y=h+1;y<=h+t;y++)D[I(x,y,z)]=5}
const gb=(x,y,z)=>x<0||x>=W||z<0||z>=W||y<0?99:y>=H?0:D[I(x,y,z)];
const solid=(x,y,z)=>{const b=gb(x,y,z);return b>0&&b!=12};
const wat=(x,y,z)=>gb(x,y,z)==12,opq=b=>b>0&&b!=12&&b!=6;
// ===== Escena =====
const scene=new THREE.Scene(),bg=new THREE.Color(0x78a7ff);scene.background=bg;scene.fog=new THREE.Fog(0x78a7ff,35,90);
const cam=new THREE.PerspectiveCamera(70,innerWidth/innerHeight,.1,250);cam.rotation.order='YXZ';
const R=new THREE.WebGLRenderer();R.setPixelRatio(Math.min(devicePixelRatio,1.5));R.setSize(innerWidth,innerHeight);document.body.appendChild(R.domElement);
