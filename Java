// ===== Texturas pixel-art 16x16 =====
const cv=document.createElement('canvas');cv.width=N*16;cv.height=16;const cx=cv.getContext('2d');
const sh=(c,k)=>[c[0]+k,c[1]+k,c[2]+k];
function tx(t,f){for(let y=0;y<16;y++)for(let x=0;x<16;x++){const c=f(x,y,hs(x,y,t));if(c){cx.fillStyle=`rgba(${c[0]|0},${c[1]|0},${c[2]|0},${c[3]??1})`;cx.fillRect(t*16+x,y,1,1)}}}
const GR=(r)=>sh([100,165,60],(r-.5)*34),dirtF=(x,y,r)=>sh([134,96,67],(r-.5)*36),stoneF=(x,y,r)=>sh([125,125,125],(r-.5)*28);
tx(0,(x,y,r)=>GR(r));
tx(1,(x,y,r)=>y<3||(y==3&&r>.5)?GR(r):dirtF(x,y,r));
tx(2,dirtF);tx(3,stoneF);
tx(4,(x,y,r)=>{const e=y%5==0||(x+((y/5)|0)*4)%8==0,c=sh([128,128,128],(r-.5)*30);return e?sh(c,-48):c});
tx(5,(x,y,r)=>sh([104,82,50],(hs(x,0,5)-.5)*40+(r-.5)*14));
tx(6,(x,y,r)=>{const d=Math.max(Math.abs(x-7.5),Math.abs(y-7.5));return d>6?sh([95,75,45],(r-.5)*20):sh(d%3<1.5?[172,142,92]:[150,120,75],(r-.5)*14)});
tx(7,(x,y,r)=>r<.2?null:sh([55,125,35],(hs(y,x,3)-.5)*60));
tx(8,(x,y,r)=>sh([219,207,163],(r-.5)*16));
const P2=[[3,3],[4,3],[3,4],[10,5],[11,5],[10,6],[6,11],[7,11],[7,12],[12,12],[13,12]];
const ore=c=>(x,y,r)=>P2.some(p=>p[0]==x&&p[1]==y)?sh(c,(r-.5)*20):stoneF(x,y,r);
tx(9,ore([28,28,28]));tx(10,ore([216,175,147]));
tx(11,(x,y,r)=>{const c=sh([157,128,79],(r-.5)*18);return y%4==3||x==((y>>2)*7+3)%16?sh(c,-35):c});
tx(12,(x,y,r)=>sh([70,70,70],(r-.5)*70));
tx(13,(x,y,r)=>[40,85,205+r*30,.65]);
const A=new THREE.CanvasTexture(cv);A.magFilter=A.minFilter=THREE.NearestFilter;A.generateMipmaps=false;
